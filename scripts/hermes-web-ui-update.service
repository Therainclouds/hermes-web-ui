[Unit]
Description=Hermes Web UI managed update runner
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
# No WorkingDirectory: the runner resolves every path from the update request
# env (absolute paths), so a baked cwd only breaks the unit when the deploy
# directory is renamed/moved after install (systemd dies with 200/CHDIR and
# updates are stuck at "starting" forever). See scripts/update-source-deploy.sh
# and scripts/install-device-package.sh for the actual execution paths.
EnvironmentFile=-{{SERVICE_ENV_FILE}}
ExecStart={{UPDATE_RUNNER_BIN}}
StandardOutput=journal
StandardError=journal
UMask=0002
