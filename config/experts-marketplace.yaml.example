# Hermes 专家市场本地接入配置示例
# 复制到 experts-marketplace.yaml 并按需修改

# 云端专家市场 baseUrl，必填，启动 fail-fast
baseUrl: "http://127.0.0.1:8000"

# catalog 内存缓存秒数
cacheTtlSeconds: 30

# 本地专家包落盘根目录
# 缺省值：${HERMES_WEBUI_STATE_DIR}/experts/packages
# localPackagesRoot: "${HERMES_WEBUI_STATE_DIR}/experts/packages"

# 客户端标识模板，{version} / {userId} 由运行时替换
clientIdTemplate: "hermes-web-ui-v{version}-user-{userId}"

# 单包最大字节数（与云端一致）
maxPackageBytes: 104857600  # 100 MiB

# 下载超时（毫秒）
downloadTimeoutMs: 60000

# 校验/解压超时（毫秒）
verifyTimeoutMs: 30000
